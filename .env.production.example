# Copy this file to ".env" on your server and fill it in.
DOMAIN=sportiq.lk
SITE_URL=https://sportiq.lk

# LOGIN FOR /admin  -- change both! Use long random values.
# Best: store only a hash. Run  docker compose run --rm --no-deps web node scripts/hash-password.mjs "your long password"
# and paste the result below, then leave ADMIN_PASSWORD out.
ADMIN_PASSWORD_HASH=
# A plain ADMIN_PASSWORD is NOT accepted in production: admin stays disabled without the hash.
# SESSION_SECRET: 32+ characters or admin stays disabled; changing it logs everyone out
SESSION_SECRET=paste-a-random-40-character-string
# Two-factor login is REQUIRED in production (admin stays disabled without it). Run: docker compose run --rm --no-deps web node scripts/totp-setup.mjs
# then add the secret to an authenticator app on your phone and paste it here.
ADMIN_TOTP_SECRET=
# Optional phone alerts for failed logins/lockouts: an ntfy.sh topic URL or a Slack/Discord webhook URL
ALERT_WEBHOOK_URL=

# No fake demo products on the live site
# Database passwords (used by the bundled MySQL container; make both long and random: openssl rand -hex 24)
DB_ROOT_PASSWORD=
DB_PASSWORD=
# (DATABASE_URL is set for you in docker-compose.yml. If you use your own MySQL/MariaDB server instead,
#  set DATABASE_URL=mysql://user:password@host:3306/sportiq here and remove the db service.)

# No fake demo products on the live site
SEED_DEMO_DATA=false

# Bank transfer details shown at checkout
BANK_NAME=
BANK_ACCOUNT_NAME=SPORTIQ
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

# Card payments (optional, from your PayHere account)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=live   # use "sandbox" while testing

# PayHere independent payment check (REQUIRED when PAYHERE_MODE=live, otherwise card payments stay switched off).
# Create a Business App in the PayHere merchant portal (Settings > Domains & Credentials), allow-list your domain, copy its App ID and App Secret.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Backup passphrase and off-site target do NOT go in this file. Put them in a separate ".backup.env" (chmod 600; see DEPLOY.md) so the
# website container never receives them.

# Behind Cloudflare or another CDN only: the header carrying the real visitor address (Cloudflare: cf-connecting-ip). Leave empty otherwise.
CLIENT_IP_HEADER=

# Only if you use your own MySQL server instead of the bundled one: TLS is mandatory for any database host other than "db"/localhost.
# DATABASE_SSL=true
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
