# Copy to .env.local and fill in. Never commit .env.local.

# MySQL 8 (or MariaDB 10.6+). The tables are created automatically on first start.
# Local: docker compose -f docker-compose.dev.yml up -d   (from the project root)
DATABASE_URL=mysql://sportiq:sportiq@127.0.0.1:3306/sportiq
# DB_POOL_SIZE=10

# Public address of the site (used for PayHere return and notify URLs)
SITE_URL=http://localhost:3000

# Admin area. In production both are required; admin stays disabled without them.
# (In local dev the password defaults to "sportiq-admin".)
ADMIN_PASSWORD=
SESSION_SECRET=

# Delivery fees (Sri Lanka 500, worldwide postage) are edited in Admin > Settings and Admin > Shipping.

# Bank transfer details shown to customers
BANK_NAME=
BANK_BRANCH=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# PayHere (https://www.payhere.lk). Leave blank to disable online payment.
# Use sandbox credentials first. Set PAYHERE_MODE=live only after PayHere approves your account.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox

# Optional
# Fill an empty database with clearly marked demo products (local testing only; keep false in production)
SEED_DEMO_DATA=true
